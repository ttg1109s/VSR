{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsr.engine/protocol/v1/schema.json",
  "title": "VSR Hybrid JSON Protocol",
  "oneOf": [
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/ack" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["protocol", "protocolVersion", "type"],
      "properties": {
        "protocol": { "const": "vsr" },
        "protocolVersion": { "const": 1 }
      }
    },
    "snapshot": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "engineId", "revision", "createdAt", "game", "state"],
          "properties": {
            "type": { "const": "snapshot" },
            "engineId": { "type": "string" },
            "revision": { "type": "integer", "minimum": 0 },
            "createdAt": { "type": "string", "format": "date-time" },
            "game": {
              "type": "object",
              "required": ["initialized", "sceneId", "routerId"],
              "properties": {
                "initialized": { "type": "boolean" },
                "sceneId": { "type": ["string", "null"] },
                "routerId": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            },
            "state": { "type": "object" },
            "source": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "engineId", "eventId", "sequence", "revision", "timestamp", "event", "payload"],
          "properties": {
            "type": { "const": "event" },
            "engineId": { "type": "string" },
            "eventId": { "type": "string" },
            "sequence": { "type": "integer", "minimum": 1 },
            "revision": { "type": "integer", "minimum": 1 },
            "timestamp": { "type": "string", "format": "date-time" },
            "event": { "type": "string" },
            "payload": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    },
    "command": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "commandId", "command", "payload"],
          "properties": {
            "type": { "const": "command" },
            "commandId": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "expectedRevision": { "type": "integer", "minimum": 0 },
            "payload": { "type": "object" }
          },
          "additionalProperties": false
        }
      ]
    },
    "ack": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["type", "commandId", "ok"],
          "properties": {
            "type": { "const": "ack" },
            "commandId": { "type": "string" },
            "ok": { "type": "boolean" },
            "revision": { "type": "integer", "minimum": 0 },
            "result": {},
            "error": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
