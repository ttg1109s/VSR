{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsr.local/schema/sprite-physics3d-state-v1.json",
  "title": "Sprite Physics 3D Body Snapshot v1",
  "type": "object",
  "required": ["id", "type", "transform", "position", "orientation", "velocity", "angularVelocity", "awake"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["dynamic", "static", "kinematic", "sensor"] },
    "radius": { "type": "number", "exclusiveMinimum": 0 },
    "mass": { "type": "number", "exclusiveMinimum": 0 },
    "transform": {
      "type": "object", "required": ["position", "orientation"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "orientation": { "$ref": "#/$defs/quat" }
      }, "additionalProperties": false
    },
    "position": { "$ref": "#/$defs/vec3" },
    "orientation": { "$ref": "#/$defs/quat" },
    "velocity": { "$ref": "#/$defs/vec3" },
    "angularVelocity": { "$ref": "#/$defs/vec3" },
    "awake": { "type": "boolean" },
    "sleepTime": { "type": "number", "minimum": 0 },
    "material": {
      "type": "object",
      "properties": {
        "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
        "staticFriction": { "type": "number", "minimum": 0 },
        "dynamicFriction": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 4, "maxItems": 4 }
  },
  "additionalProperties": false
}
