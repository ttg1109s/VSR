{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsr-engine.local/schema/sprite-protocol-v3.schema.json",
  "title": "VSR Sprite Simulation Protocol v3",
  "type": "object",
  "required": ["protocol", "protocolVersion", "simulationId", "physicsVersion", "dimension", "time", "completion", "bodies", "events", "diagnostics"],
  "properties": {
    "protocol": { "const": "vsr.sprite.protocol.v3" },
    "protocolVersion": { "const": 3 },
    "simulationId": { "type": "string", "minLength": 1 },
    "physicsVersion": { "type": "string", "minLength": 1 },
    "dimension": { "enum": ["2D", "3D"] },
    "time": { "type": "object", "required": ["tStart", "tEnd", "fixedDt", "ticks"], "properties": { "tStart": { "type": "number" }, "tEnd": { "type": "number" }, "fixedDt": { "type": "number", "exclusiveMinimum": 0 }, "ticks": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "completion": { "type": "object", "required": ["status", "reason"], "properties": { "status": { "enum": ["completed", "natural-rest", "kinematic-complete", "cancelled", "failed"] }, "reason": { "type": "string" }, "watchdogExceeded": { "type": "boolean" } }, "additionalProperties": true },
    "bodies": { "type": "array", "items": { "type": "object", "required": ["id", "position", "orientation", "velocity", "angularVelocity"], "properties": { "id": { "type": "string" }, "type": { "enum": ["dynamic", "static", "kinematic", "sensor"] }, "position": { "$ref": "#/$defs/vec3" }, "orientation": { "$ref": "#/$defs/quat" }, "velocity": { "$ref": "#/$defs/vec3" }, "angularVelocity": { "$ref": "#/$defs/vec3" }, "awake": { "type": "boolean" } }, "additionalProperties": true } },
    "events": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" }, "t": { "type": "number" } }, "additionalProperties": true } },
    "trajectories": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "object" }
  },
  "$defs": { "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }, "quat": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } },
  "additionalProperties": false
}
