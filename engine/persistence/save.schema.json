{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://vsr.engine/save/v5/schema.json",
  "title": "VSR Save Envelope",
  "type": "object",
  "required": [
    "protocol",
    "saveVersion",
    "scenario",
    "state",
    "savedAt"
  ],
  "properties": {
    "protocol": {
      "const": "vsr-save"
    },
    "saveVersion": {
      "const": 5
    },
    "scenario": {
      "type": "object"
    },
    "state": {
      "type": "object"
    },
    "chatState": {
      "type": "object"
    },
    "pendingPasswordAction": {
      "type": [
        "object",
        "null"
      ]
    },
    "endingState": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "activatedAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "taskRemainingMs": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "pausedTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(auto_|move_char_|move_still_|router_still_|timer_ui_|timer_end_)[^/]+$"
      }
    },
    "automationRandomBags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "activeSpriteMotions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completedSpriteMotions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completedSpriteMotionIdentities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "spriteId",
          "trajectoryId"
        ],
        "properties": {
          "spriteId": {
            "type": "string"
          },
          "trajectoryId": {
            "type": "string"
          }
        }
      }
    },
    "pendingSpriteMotionEndHooks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "effects",
          "context",
          "completion",
          "committedSprites"
        ],
        "properties": {
          "effects": {
            "type": "array"
          },
          "context": {
            "type": "object"
          },
          "completion": {
            "type": "object"
          },
          "committedSprites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "spriteMotionSequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
