{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vsr.engine/protocol/v1/sprite-motion.json",
  "title": "VSR Sprite Motion Event Payload",
  "type": "object",
  "required": [
    "spriteId",
    "start",
    "end",
    "geometryMode",
    "path",
    "duration",
    "easing",
    "motionId"
  ],
  "properties": {
    "spriteId": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "$ref": "#/definitions/point3",
      "description": "Runtime Sprite position immediately before this effect."
    },
    "end": {
      "$ref": "#/definitions/point3",
      "description": "Runtime position requested by this effect."
    },
    "geometryMode": {
      "type": "string",
      "enum": [
        "geometry-preserving",
        "absolute"
      ],
      "description": "Source waypoint transformation mode used by Engine."
    },
    "path": {
      "type": "object",
      "required": [
        "type",
        "points"
      ],
      "properties": {
        "type": {
          "enum": [
            "bezier"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/definitions/point3"
          },
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "easing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "sin_in",
        "sin_out",
        "sin_in_out",
        "step"
      ]
    },
    "impact": {
      "type": "object",
      "default": {
        "enable": false,
        "physics": false
      },
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false,
          "description": "Bật collision event trong thời gian motion."
        },
        "physics": {
          "type": "boolean",
          "default": false,
          "description": "Bật phản ứng vật lý khi collision được xác nhận; chỉ có hiệu lực khi enable=true."
        }
      },
      "required": [
        "enable",
        "physics"
      ],
      "additionalProperties": false
    },
    "motionId": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Runtime Sprite motion event. The four Bezier points are the runtime Start, two effective intermediate controls, and runtime End."
}
