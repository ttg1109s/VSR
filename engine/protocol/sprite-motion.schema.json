{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vsr.engine/protocol/v1/sprite-motion.json",
  "title": "VSR Sprite Motion Event Payload",
  "type": "object",
  "required": [
    "spriteId",
    "path",
    "duration",
    "easing"
  ],
  "properties": {
    "spriteId": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "object",
      "required": [
        "type",
        "points"
      ],
      "properties": {
        "type": {
          "enum": [
            "bezier"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/point3"
          }
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "easing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "sin_in",
        "sin_out",
        "sin_in_out",
        "step"
      ]
    }
  },
  "definitions": {
    "point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
