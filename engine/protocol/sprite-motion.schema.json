{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vsr.engine/protocol/v1/sprite-motion.json",
  "title": "VSR Sprite Motion Event Payload",
  "type": "object",
  "required": [
    "spriteId",
    "path",
    "duration",
    "easing",
    "motionId"
  ],
  "properties": {
    "spriteId": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "object",
      "required": [
        "type",
        "points"
      ],
      "properties": {
        "type": {
          "enum": [
            "bezier"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/point3"
          }
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "easing": {
      "enum": [
        "linear",
        "ease_in",
        "ease_out",
        "ease_in_out",
        "sin_in",
        "sin_out",
        "sin_in_out",
        "step"
      ]
    },
    "impact": {
      "type": "object",
      "default": {
        "enable": false,
        "physics": false
      },
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false,
          "description": "B\u1eadt collision event trong th\u1eddi gian motion."
        },
        "physics": {
          "type": "boolean",
          "default": false,
          "description": "B\u1eadt ph\u1ea3n \u1ee9ng v\u1eadt l\u00fd khi collision \u0111\u01b0\u1ee3c x\u00e1c nh\u1eadn; ch\u1ec9 c\u00f3 hi\u1ec7u l\u1ef1c khi enable=true."
        }
      },
      "required": [
        "enable",
        "physics"
      ],
      "additionalProperties": false
    },
    "motionId": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
