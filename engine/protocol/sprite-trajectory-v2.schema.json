{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vsr.engine/protocol/v2/sprite-trajectory.json",
  "title": "VSR Authoritative Sprite Trajectory v2",
  "type": "object",
  "required": [
    "protocolVersion",
    "spriteId",
    "motionId",
    "trajectoryId",
    "startTime",
    "endTime",
    "trajectories",
    "finalPositions",
    "impacts",
    "presentation"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "spriteId": {
      "type": "string",
      "minLength": 1
    },
    "motionId": {
      "type": "string",
      "minLength": 1
    },
    "trajectoryId": {
      "type": "string",
      "minLength": 1
    },
    "startTime": {
      "type": "number"
    },
    "endTime": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "requestedTarget": {
      "$ref": "#/definitions/vector3"
    },
    "initialTrajectory": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/segment"
      }
    },
    "trajectories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/segment"
        }
      }
    },
    "finalPositions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/vector3"
      }
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "time",
          "spriteA",
          "spriteB",
          "contactA",
          "contactB",
          "normal",
          "velocityAfterA",
          "velocityAfterB"
        ],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "time": {
            "type": "number"
          },
          "spriteA": {
            "type": "string"
          },
          "spriteB": {
            "type": "string"
          },
          "contactA": {
            "$ref": "#/definitions/vector3"
          },
          "contactB": {
            "$ref": "#/definitions/vector3"
          },
          "normal": {
            "$ref": "#/definitions/vector3"
          },
          "velocityBeforeA": {
            "$ref": "#/definitions/vector3"
          },
          "velocityBeforeB": {
            "$ref": "#/definitions/vector3"
          },
          "velocityAfterA": {
            "$ref": "#/definitions/vector3"
          },
          "velocityAfterB": {
            "$ref": "#/definitions/vector3"
          },
          "impulse": {
            "type": "number"
          },
          "physicsEnabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "geometryMode": {
      "type": "string",
      "enum": [
        "geometry-preserving",
        "absolute"
      ]
    },
    "presentation": {
      "type": "object",
      "required": [
        "requiredSegments"
      ],
      "properties": {
        "requiredSegments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "transformTrajectory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "rotate",
          "scale"
        ],
        "properties": {
          "time": {
            "type": "number"
          },
          "rotate": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "segmentId",
        "type",
        "startTime",
        "endTime"
      ],
      "properties": {
        "segmentId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "bezier",
            "physics"
          ]
        },
        "startTime": {
          "type": "number"
        },
        "endTime": {
          "type": "number"
        },
        "controlPoints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/vector3"
          }
        },
        "easing": {
          "type": "string"
        },
        "initialPosition": {
          "$ref": "#/definitions/vector3"
        },
        "initialVelocity": {
          "$ref": "#/definitions/vector3"
        },
        "acceleration": {
          "$ref": "#/definitions/vector3"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
