{
  "name": "vsr-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./engine/index.js",
  "exports": {
    ".": "./engine/index.js",
    "./protocol": "./protocol/index.js",
    "./notifications": "./engine/modules/Notification.js",
    "./scenario-schema": "./scenario.schema.json",
    "./scenario": "./engine/scenario/Scenario.js",
    "./save-schema": "./engine/persistence/save.schema.json",
    "./state": "./state/StateAccess.js",
    "./utils": "./utils/index.js",
    "./host": "./engine/LocalEngineHost.js",
    "./client": "./client/adapters/JsonClient.js",
    "./transport": "./client/adapters/WorkerJsonTransport.js"
  },
  "scripts": {
    "test": "node --test",
    "audit:state": "node tools/audit-state-access.js",
    "audit:state:strict": "node tools/audit-state-access.js --strict",
    "schema:sync": "node tools/generate-scenario-schema.js",
    "schema:check": "node tools/generate-scenario-schema.js && git diff --exit-code -- engine/scenario/ScenarioSchema.js",
    "server": "node server/index.js",
    "check:server": "node --check server/index.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "acorn": "^8.15.0"
  }
}
