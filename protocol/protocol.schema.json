{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsr.engine/protocol/v2/schema.json",
  "title": "VSR Hybrid JSON Protocol v2",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/ack"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "protocol",
        "protocolVersion",
        "type"
      ],
      "properties": {
        "protocol": {
          "const": "vsr"
        },
        "protocolVersion": {
          "const": 2
        }
      }
    },
    "snapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "type",
            "engineId",
            "revision",
            "stateRevision",
            "eventSequence",
            "createdAt",
            "game",
            "state"
          ],
          "properties": {
            "type": {
              "const": "snapshot"
            },
            "engineId": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "stateRevision": {
              "type": "integer",
              "minimum": 0
            },
            "eventSequence": {
              "type": "integer",
              "minimum": 0
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "game": {
              "type": "object",
              "required": [
                "initialized",
                "sceneId",
                "routerId"
              ],
              "properties": {
                "initialized": {
                  "type": "boolean"
                },
                "sceneId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "routerId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "state": {
              "type": "object"
            },
            "source": {
              "type": "object"
            },
            "presentation": {
              "type": "object",
              "properties": {
                "scenarioTitle": {
                  "type": "string"
                },
                "scene": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "router": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "scenePath": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/actionProjection"
                  }
                }
              }
            },
            "session": {
              "type": "object",
              "properties": {
                "chat": {
                  "type": "object"
                },
                "passwordChallenge": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/passwordChallenge"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notifications": {
                  "type": "object",
                  "properties": {
                    "pending": {
                      "type": "array"
                    },
                    "history": {
                      "type": "array"
                    }
                  }
                },
                "timer": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "active": {
                      "type": "boolean"
                    },
                    "sceneId": {
                      "type": "string"
                    },
                    "routerId": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string"
                    },
                    "maxSeconds": {
                      "type": "number"
                    },
                    "remainingSeconds": {
                      "type": "number"
                    },
                    "displayText": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "type",
            "engineId",
            "eventId",
            "sequence",
            "revision",
            "stateRevision",
            "timestamp",
            "event",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "event"
            },
            "engineId": {
              "type": "string"
            },
            "eventId": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "stateRevision": {
              "type": "integer",
              "minimum": 0
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "event": {
              "type": "string"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      ]
    },
    "command": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "type",
            "commandId",
            "command",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "command"
            },
            "commandId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "expectedStateRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ack": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "type",
            "commandId",
            "ok"
          ],
          "properties": {
            "type": {
              "const": "ack"
            },
            "commandId": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "stateRevision": {
              "type": "integer",
              "minimum": 0
            },
            "result": {},
            "error": {
              "type": "object"
            }
          }
        }
      ]
    },
    "actionProjection": {
      "type": "object",
      "required": [
        "id",
        "key",
        "title",
        "meta",
        "presentation",
        "availability",
        "runtimeState"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "desc": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "subTitleStatus": {
              "type": "string"
            },
            "thumb": {},
            "cover": {
              "type": [
                "object",
                "null"
              ]
            },
            "thumbnail": {
              "type": [
                "object",
                "null"
              ]
            },
            "buttonLabel": {
              "type": "string"
            },
            "buttonIcon": {
              "type": "string"
            }
          }
        },
        "presentation": {
          "type": "object",
          "required": [
            "display",
            "readRequired",
            "read"
          ],
          "properties": {
            "display": {
              "enum": [
                "show",
                "locked"
              ]
            },
            "readRequired": {
              "type": "boolean"
            },
            "read": {
              "type": "boolean"
            }
          }
        },
        "availability": {
          "type": "object",
          "required": [
            "canTrigger",
            "reason",
            "cooldownUntil",
            "checks"
          ],
          "properties": {
            "canTrigger": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                "available",
                "locked",
                "busy",
                "permission_denied",
                "not_read",
                "cooldown",
                "target_locked",
                "requirement_failed",
                "password_required"
              ]
            },
            "cooldownUntil": {
              "type": [
                "number",
                "null"
              ]
            },
            "checks": {
              "type": "object",
              "required": ["permission", "requirement"],
              "properties": {
                "permission": { "enum": ["passed", "failed"] },
                "requirement": { "enum": ["passed", "failed", "not_required", "not_evaluated"] }
              },
              "additionalProperties": false
            }
          }
        },
        "runtimeState": {
          "type": "object",
          "required": [
            "display",
            "readDesc"
          ],
          "properties": {
            "display": {
              "type": "string"
            },
            "readDesc": {
              "type": "boolean"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "passwordChallenge": {
      "type": "object",
      "required": [
        "challengeId",
        "type",
        "actionId",
        "uniqueId",
        "sceneId",
        "routerId",
        "status",
        "countTest",
        "retryMax",
        "remainingAttempts",
        "deadlineAt"
      ],
      "properties": {
        "challengeId": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "uniqueId": {
          "type": "string"
        },
        "sceneId": {
          "type": "string"
        },
        "routerId": {
          "type": "string"
        },
        "status": {
          "const": "active"
        },
        "countTest": {
          "type": "integer",
          "minimum": 0
        },
        "retryMax": {
          "type": "integer",
          "minimum": 0
        },
        "remainingAttempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "deadlineAt": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "puzzle": {
          "type": "object",
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "ratio": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "level": {}
          }
        },
        "findWay": {
          "type": "object",
          "properties": {
            "area": {
              "type": [
                "array",
                "null"
              ]
            },
            "start": {
              "type": [
                "array",
                "null"
              ]
            },
            "target": {
              "type": [
                "array",
                "null"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
